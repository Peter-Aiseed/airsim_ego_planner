<launch>
    <node pkg="nodelet" type="nodelet" args="manager" name="depth_to_pointcloud_manager" output="screen"/>

    <node pkg="nodelet" type="nodelet" name="front_depth2cloud" args="load depth_image_proc/point_cloud_xyz depth_to_pointcloud_manager" output="screen">
        <remap from="image_rect" to="/airsim_node/drone_0/cube_front/DepthPlanar"/>
        <remap from="/airsim_node/drone_0/cube_front/camera_info" to="/airsim_node/drone_0/cube_front/DepthPlanar/camera_info"/>
        <remap from="points" to="/airsim_node/drone_0/cube_front/DepthPlanar/registered/points"/>
        <param name="approximate_sync" value="true" />
        <param name="queue_size" value="10" />
    </node>

    <node pkg="nodelet" type="nodelet" name="right_depth2cloud" args="load depth_image_proc/point_cloud_xyz depth_to_pointcloud_manager" output="screen">
        <remap from="image_rect" to="/airsim_node/drone_0/cube_right/DepthPlanar"/>
        <remap from="/airsim_node/drone_0/cube_right/camera_info" to="/airsim_node/drone_0/cube_right/DepthPlanar/camera_info"/>
        <remap from="points" to="/airsim_node/drone_0/cube_right/DepthPlanar/registered/points"/>
        <param name="approximate_sync" value="true" />
        <param name="queue_size" value="10" />
    </node>

    <node pkg="nodelet" type="nodelet" name="back_depth2cloud" args="load depth_image_proc/point_cloud_xyz depth_to_pointcloud_manager" output="screen">
        <remap from="image_rect" to="/airsim_node/drone_0/cube_back/DepthPlanar"/>
        <remap from="/airsim_node/drone_0/cube_back/camera_info" to="/airsim_node/drone_0/cube_back/DepthPlanar/camera_info"/>
        <remap from="points" to="/airsim_node/drone_0/cube_back/DepthPlanar/registered/points"/>
        <param name="approximate_sync" value="true" />
        <param name="queue_size" value="10" />
    </node>

    <node pkg="nodelet" type="nodelet" name="left_depth2cloud" args="load depth_image_proc/point_cloud_xyz depth_to_pointcloud_manager" output="screen">
        <remap from="image_rect" to="/airsim_node/drone_0/cube_left/DepthPlanar"/>
        <remap from="/airsim_node/drone_0/cube_left/camera_info" to="/airsim_node/drone_0/cube_left/DepthPlanar/camera_info"/>
        <remap from="points" to="/airsim_node/drone_0/cube_left/DepthPlanar/registered/points"/>
        <param name="approximate_sync" value="true" />
        <param name="queue_size" value="10" />
    </node>

    <include file="$(find pointcloud_concatenate)/launch/concat.launch">
		<arg name="target_frame" default="world_enu" />
        <arg name="hz" default="3" />
		<arg name="cloud_in1" default="/airsim_node/drone_0/cube_front/DepthPlanar/registered/points" />
		<arg name="cloud_in2" default="/airsim_node/drone_0/cube_right/DepthPlanar/registered/points" />
		<arg name="cloud_in3" default="/airsim_node/drone_0/cube_back/DepthPlanar/registered/points" />
		<arg name="cloud_in4" default="/airsim_node/drone_0/cube_left/DepthPlanar/registered/points" />
		<arg name="cloud_out" default="cloud_concatenated" />
	</include>

     <node name="rviz" pkg="rviz" type="rviz" args="-d $(find ego_planner)/launch/airsim.rviz" output="screen" />

</launch>